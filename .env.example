POSTGRES_DB=login_authenticator
POSTGRES_USER=auth_service
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://auth_service:change-me-locally@postgres:5432/login_authenticator

JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
JWT_ISSUER=login-authenticator
JWT_AUDIENCE=login-authenticator-client

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
ARGON2_HASH_LENGTH=32
ARGON2_SALT_LENGTH=16

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=1
AFK_TIMEOUT_MINUTES=30
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300

# Expo client configuration; this is not a secret and is visible in the app.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
