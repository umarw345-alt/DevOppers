# Copy to .env and change POSTGRES_PASSWORD (and the two URLs that contain it).
POSTGRES_DB=login_authenticator
POSTGRES_USER=auth_service
POSTGRES_PASSWORD=change-me-locally

# Used when running the API with uv from backend/. Docker containers build
# their own URL (host "postgres") in docker-compose.yml. Use 127.0.0.1, not
# localhost: Postgres only listens on IPv4, and on Windows localhost tries IPv6
# first and can hang.
DATABASE_URL=postgresql+psycopg://auth_service:change-me-locally@127.0.0.1:5432/login_authenticator
# Used by the opt-in integration tests to age a session directly in the database.
AUTH_INTEGRATION_DATABASE_URL=postgresql://auth_service:change-me-locally@127.0.0.1:5432/login_authenticator

# Relative to backend/ when running with uv. Docker mounts ./secrets itself.
JWT_PRIVATE_KEY_PATH=../secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=../secrets/jwt-public.pem
JWT_ISSUER=login-authenticator
JWT_AUDIENCE=login-authenticator-client

# Apple Wallet signing paths. These are server-only and optional until Apple
# pass signing is configured. Never expose them to Expo or commit the files.
# Relative to backend/ when running with uv; Docker paths will be configured
# separately once the signing files exist.
APPLE_PASS_CERTIFICATE_PATH=../secrets/apple-pass.cer
APPLE_PASS_PRIVATE_KEY_PATH=../secrets/apple-pass.key
APPLE_WWDR_CERTIFICATE_PATH=../secrets/apple-wwdr.cer

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
ARGON2_HASH_LENGTH=32
ARGON2_SALT_LENGTH=16

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=1
AFK_TIMEOUT_MINUTES=30
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300

# Resume upload reads files with Claude. Get a key at console.anthropic.com.
# Without it, POST /resume/upload returns 503 and everything else still works.
ANTHROPIC_API_KEY=
# Optional overrides (defaults: claude-haiku-5-5 at medium effort)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=high

# Expo client configuration; this is not a secret and is visible in the app.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
WEB_COOKIE_SECURE=false
WEB_COOKIE_SAMESITE=lax
